            Send Help
        End_Procedure 

    End_Object    

    Object oOrderBy is a RadioGroup
        Set Size to 57 58
        Set Location to 53 208
        Set peAnchors to anRight
        Set Label to "Order by"
        Object oName is a Radio
            Set Label to "Name"
            Set Size to 10 35
            Set Location to 19 3

            Set Label to "Name"

        End_Object    

        Object oDescription is a Radio
            Set Label to "C_$Description"
            Set Size to 10 52
            Set Location to 32 3

            Set Label to C_$Description

        End_Object    


        Set Label to "Order by"
        
        Procedure Notify_Select_State integer iToItem integer iFromItem
            Integer iWorkspace
            Handle hoWorkspaces
        
            Set pbSortByName To (iToItem =0)
        
            Get ItemData of oWorkspaces (CurrentTreeItem(oWorkspaces(self))) To iWorkspace
            Set psWorkspaceSelected To (Value(oWorkspacesList(self), iWorkspace *3))
            Set CurrentTreeItem of oWorkspaces To -1 // stops all the item-changing events
        
            Send DoShowWorkspaces of oWorkspaces
        End_Procedure

    End_Object    

    Object oCurrentWorkspace_lb is a Textbox
        Set Label to "Current Workspace"
        Set Location to 5 8
        Set Size to 10 63
        Set FontWeight to 800

        Set Label to "Current Workspace"

    End_Object    

    Object oCurrentWorkspace is a Textbox
        Set Label to "oTextBox2"
        Set Auto_Size_State to FALSE
        Set Location to 17 5
        Set Size to 14 261
        Set Border_Style to Border_StaticEdge
        Set peAnchors to anLeftRight

        Procedure DoShowCurrentWorkspace
            String sDescription sName
        
            Delegate Get psOriginalWorkspace To sName
            Delegate Get psCurrentWorkspaceDescription to sDescription
        
            If (sDescription = "") ;
                Move ("<" + C_$Undefined + ">") To sDescription
            If (sName = "") ;
                Move ("<" + C_$Undefined + ">") To sName
        
            Set Value To (sDescription * "- [" +sName +"]")
        End_Procedure

    End_Object    

    Object oLineControl2 is a LineControl
        Set Size to 2 267
        Set Location to 39 2
        Set peAnchors to anLeftRight

        Procedure Set GuiSize Integer cy Integer cx
            Forward Set GuiSize To 2 cx
        End_Procedure

    End_Object    

    Object oSelectedWorkspace is a Textbox
        Set Label to "Selected Workspace"
        Set Auto_Size_State to FALSE
        Set Location to 212 5
        Set Size to 14 261
        Set Border_Style to Border_StaticEdge
        Set peAnchors to anBottomLeftRight

        Set Label to "Selected Workspace"

    End_Object    

    Object oSelectNewWorkspace_lb is a Textbox
        Set Label to "Select New Workspace"
        Set Location to 44 8
        Set Size to 10 78
        Set FontWeight to 800

        Set Label to "Select New Workspace"

    End_Object    

    Object oOpenDialog is a OpenDialog
        Set Dialog_Caption to "Select a Workspace File"
        Set Filter_String to "Workspace Files (*.ws)|*.ws"

                
        Procedure Default_Initial_Folder
            // Description
            // -----------
            // Determine the default Initial_Folder.
            String sDefaultWorkspacePath
            Get_Profile_String "Defaults" "DefaultWorkspacePath" To sDefaultWorkspacePath
            If (Right(sDefaultWorkspacePath,1) = "\") Begin
                Move (Left(sDefaultWorkspacePath, Length(sDefaultWorkspacePath)-1)) to sDefaultWorkspacePath
            End
        
            Set Initial_Folder To sDefaultWorkspacePath
        End_Procedure  
        
        Send Default_Initial_Folder
        

    End_Object    

    Object oSections is a Array

        // This array contains the list of Workspace Names.
        


                
                

    End_Object    


    Set Label to "Select Workspace"
    
    // === PUBLIC INTERFACE ===
    Function SelectWorkspace Returns Boolean // new WS selected?
        Boolean bWorkspaceSelected
        String sWorkspaceName
    
        Set pbResult To False
        Get psWorkspaceName Of (phoWorkspace (ghoApplication)) To sWorkspaceName
        If (sWorkspaceName = "") Begin
            Move (GetCurrentUserWorkspace()) To sWorkspaceName
        End
        Set psOriginalWorkspace To sWorkspaceName
        Set psWorkspaceSelected To (psOriginalWorkspace(self))
    
        Set Enabled_State of oHelp To (Help_Id(self)) // disable if no Help_Id set (by calling program)
    
        Send Popup_Modal
    
        Move (pbResult(self) = True and psOriginalWorkspace(self) <> psWorkspaceSelected(self)) To bWorkspaceSelected
    
        If bWorkspaceSelected Begin
            If (pbChangeSystemCurrent(self)) Begin
                Send SetCurrentUserWorkspace (psWorkspaceSelected(self))
            End
        End
    
        Function_Return bWorkspaceSelected
    End_Function

End_Object    




